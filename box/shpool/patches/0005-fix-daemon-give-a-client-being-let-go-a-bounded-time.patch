 // shell->client thread.
 const SHELL_TO_CLIENT_CTL_TIMEOUT: time::Duration = time::Duration::from_millis(300);
 
+// How long a client that is replaced or detached gets to take its exit
+// status. The thread acks only after that write, and the sender waits
+// SHELL_TO_CLIENT_CTL_TIMEOUT for the ack: a client that stopped reading must
+// not hold the write past it, or the late ack blocks the thread for good.
+const DETACH_EXIT_CHUNK_WRITE_TIMEOUT: time::Duration = time::Duration::from_millis(100);
+
+// How long the client of a shell that exited gets to take its exit status.
+// The ack goes out first, so a slow client can take its time; the bound only
+// keeps a dead one from holding the thread, and the session joining it, for
+// good.
+const SHELL_EXIT_CHUNK_WRITE_TIMEOUT: time::Duration = time::Duration::from_secs(5);
+
 /// Lifecycle state tracking when sessions were last connected/disconnected and
 /// by whom. The fields update in lockstep, so they live behind a single private
 /// lock that only this type's methods take, exactly once per update or read.
@@ -221,6 +233,16 @@ impl ClientConnection {
     fn write_chunk(&mut self, chunk: Chunk) -> io::Result<()> {
         chunk.write_to(&mut self.sink).and_then(|_| self.sink.flush())
     }
+
+    /// Sends the client its exit status, waiting at most timeout for it to
+    /// take it, and shuts its socket.
+    fn hang_up(mut self, status: i32, timeout: time::Duration) -> anyhow::Result<()> {
+        if let Err(e) = self.stream.set_write_timeout(Some(timeout)) {
+            warn!("bounding the exit status write: {:?}", e);
+        }
+        SessionInner::write_exit_chunk(&mut self.sink, status);
+        shutdown_socket(&self.stream, net::Shutdown::Both)
+    }
 }
 
