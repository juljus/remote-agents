+    /// Hands stream to the shell->client thread as its new client.
+    fn attach(
+        ctl: &Mutex<ShellToClientCtl>,
+        stream: &UnixStream,
+    ) -> anyhow::Result<ClientConnectionStatus> {
+        let ctl = ctl.lock();
+        ctl.client_connection.send_timeout(
+            ClientConnectionMsg::New(ClientConnection {
+                sink: io::BufWriter::new(stream.try_clone()?),
+                size: TtySize { rows: 24, cols: 80, xpixel: 0, ypixel: 0 },
