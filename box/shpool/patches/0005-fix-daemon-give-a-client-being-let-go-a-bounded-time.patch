+
+    /// Fills the socket so that the next write to it blocks, as it does for
+    /// a client that stopped reading.
+    fn fill(stream: &UnixStream) -> anyhow::Result<()> {
+        stream.set_nonblocking(true)?;
+        let filler = [0u8; 4096];
+        let mut sink = stream;
+        loop {
+            match sink.write(&filler) {
+                Ok(_) => continue,
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => break,
+                Err(e) => return Err(e.into()),
+            }
+        }
+        Ok(stream.set_nonblocking(false)?)
     }
 
