 impl SessionInner {
+    /// Reports how the shell->client thread ended, or None while it runs.
+    /// Joins the thread when it is first found finished.
+    pub fn shell_to_client_exit(&mut self) -> Option<ShellToClientExit> {
+        if self.shell_to_client_outcome.is_none() {
+            let join_h = self.shell_to_client_join_h.take_if(|h| h.is_finished())?;
+            self.shell_to_client_outcome = Some(match join_h.join() {
+                Ok(Ok(())) => ShellToClientExit::Clean,
+                Ok(Err(e)) => ShellToClientExit::Failed(format!("{e:#}")),
+                Err(panic) => ShellToClientExit::Failed(format!("panicked: {panic:?}")),
+            });
+        }
+        self.shell_to_client_outcome.clone()
+    }
