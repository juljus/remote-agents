+
+/// How the shell->client thread of a session ended.
+#[derive(Debug, Clone)]
+pub enum ShellToClientExit {
+    /// The thread returned cleanly, which it only does once the shell is gone.
+    Clean,
+    /// The thread failed. Nothing relays the shell's output any more, so the
+    /// session can never be attached again, even if its shell still runs.
+    Failed(String),
 }
 
