# Personal values of the box bootstrap. Copy to bootstrap.env (gitignored) and fill in every value;
# the scripts refuse to run while one is missing. Sourced by bash on the laptop.

# The box user, created by provision.sh; the only account SSH lets in.
BOX_USER=agent
# Its home. Giving it the laptop's home path (/Users/<you>) makes absolute paths in Claude settings,
# memories and project keys match, so sync-claude.sh and copy-transcripts.sh carry them over as is.
BOX_HOME=/home/agent
# Created for the box user; the workdir in the laptop's config.toml.
BOX_WORKDIR=/home/agent/work
# Public keys allowed to log in as BOX_USER, as a laptop file in authorized_keys format.
BOX_AUTHORIZED_KEYS="$HOME/.ssh/id_ed25519.pub"

# Git identity of the box user, set by user/setup.sh.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL=you@example.com

# sync-repos.sh only: globs relative to $HOME, quoted; every git repo they match is mirrored to the
# same path on the box.
SYNC_REPOS=("src/*")
