[Unit]
Description=Public NIC firewall of the box
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ExecStart=/usr/sbin/nft -f /etc/box-firewall/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/box-firewall/firewall.nft
ExecStop=/usr/sbin/nft delete table inet box_firewall

[Install]
WantedBy=sysinit.target
