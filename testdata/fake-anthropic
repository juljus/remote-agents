#!/usr/bin/env python3
"""Stands in for Anthropic's OAuth token and usage endpoints in end-to-end
tests. Each refresh token fake-refresh-<tag>-<n> works once, as a rotating
server's does; usage is 10% per letter of the tag. Writes its port to argv[1]."""
import json
import re
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

used = set()
issued = [100]


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        if self.path != "/token":
            return self.reply(404, {})
        req = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        token = req.get("refresh_token", "")
        m = re.fullmatch(r"fake-refresh-([a-z]+)-\d+", token)
        if req.get("grant_type") != "refresh_token" or not m or token in used:
            return self.reply(400, {"error": "invalid_grant"})
        used.add(token)
        issued[0] += 1
        tag, n = m[1], issued[0]
        self.reply(200, {"access_token": f"fake-access-{tag}-{n}", "refresh_token": f"fake-refresh-{tag}-{n}",
                         "expires_in": 28800, "refresh_token_expires_in": 2592000, "scope": req.get("scope", "")})

    def do_GET(self):
        m = re.fullmatch(r"Bearer fake-access-([a-z]+)-\d+", self.headers.get("Authorization", ""))
        if self.path != "/api/oauth/usage" or not m:
            return self.reply(401, {})
        self.reply(200, {"five_hour": {"utilization": 10 * len(m[1]), "resets_at": "2030-01-01T00:00:00+00:00"},
                         "seven_day": None, "limits": []})


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
with open(sys.argv[1], "w") as f:
    f.write(str(server.server_address[1]))
server.serve_forever()
